{
  "name": "@aifn/dsh-aifn-harness",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness tools for writing, validating, and submitting aifn result files.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./filesystem": "./src/filesystem.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src", "cordis.patch.yml"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=22" },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-sandbox": "*",
    "@deepseek-ai/dsh-tool-str-replace-editor": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
